{
  "name": "ericka-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://erickatres.github.io/ericka-portfolio",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"try { const fs = require('fs'); const path = require('path'); const viteBin = path.join('node_modules', '.bin', 'vite'); fs.chmodSync(viteBin, 0o755); } catch (e) {}\"",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && gh-pages -d dist"
  },
  "dependencies": {
    "lucide-react": "^0.263.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1"
  }
}
